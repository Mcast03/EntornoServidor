package collections;

import java.util.Random;

public class Coche {
	private Enum marca;
	private Enum color;

	public Coche(Enum marca, Enum color) {
		
		if (marca == null) {
			Random rm = new Random();
			this.marca = rm(Enum marca);
		}
		
		else
			this.marca = marca;
		
		if (color==null) {
			Random rm = new Random();
			this.marca = rm(Enum marca);
		}
		
		else
			this.color = color;
		
	}
}
